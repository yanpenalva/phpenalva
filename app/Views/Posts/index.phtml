<header class="page-header"><p class="eyebrow">Community</p><h1>Posts</h1><p>Ideas, updates, and notes from the PHPenalva community.</p></header>
<?php if (empty($this->view->posts)): ?><section class="empty-state"><h2>No posts yet</h2><p>There are no posts to show right now. Check back soon.</p><a class="btn btn-primary" href="/">Explore PHPenalva</a></section><?php else: ?><div class="post-grid">
<?php foreach ($this->view->posts as $post): ?><article class="post-card"><p class="post-id">Post #<?php echo htmlspecialchars((string) $post->id, ENT_QUOTES, 'UTF-8'); ?></p><p><?php echo htmlspecialchars((string) $post->description, ENT_QUOTES, 'UTF-8'); ?></p><a href="/post/<?php echo rawurlencode((string) $post->id); ?>">Read post →</a></article><?php endforeach; ?>
</div><?php endif; ?>
